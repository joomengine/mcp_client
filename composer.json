{
  "name": "joomengine/mcp-client",
  "description": "Standalone PHP client for database-driven JoomEngine MCP servers",
  "keywords": ["joomla", "joomengine", "mcp", "model-context-protocol", "client", "stdio"],
  "homepage": "https://github.com/joomengine/mcp_client",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "support": {
    "issues": "https://github.com/joomengine/mcp_client/issues",
    "source": "https://github.com/joomengine/mcp_client",
    "docs": "https://github.com/joomengine/mcp_client/blob/main/README.md"
  },
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "mcp/sdk": "~0.8.1",
    "nyholm/psr7": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "VDM\\Joomla\\Mcp\\Client\\": "src/"
    }
  },
  "scripts": {
    "test": [
      "php tests/run.php",
      "php tests/configuration.php",
      "php tests/cli.php",
      "php tests/bridge.php",
      "bash tests/http.sh"
    ],
    "test:packagist": "bash tests/packagist.sh"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    },
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/.github",
      "/tests",
      "/build",
      "/vendor"
    ]
  },
  "bin": [
    "bin/joomengine-mcp"
  ],
  "suggest": {
    "ext-posix": "Required for private per-site credential storage on POSIX systems",
    "ext-pcntl": "Enables graceful SIGINT and SIGTERM handling in the remote stdio bridge"
  }
}
